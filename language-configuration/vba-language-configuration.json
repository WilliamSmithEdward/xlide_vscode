{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^[ \\t]*(?:(?:[Pp][Uu][Bb][Ll][Ii][Cc]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Ff][Rr][Ii][Ee][Nn][Dd]|[Gg][Ll][Oo][Bb][Aa][Ll]|[Ss][Tt][Aa][Tt][Ii][Cc])[ \\t]+)*(?:[Ss][Uu][Bb]|[Ff][Uu][Nn][Cc][Tt][Ii][Oo][Nn])[ \\t]+\\w|^[ \\t]*(?:(?:[Pp][Uu][Bb][Ll][Ii][Cc]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Ff][Rr][Ii][Ee][Nn][Dd])[ \\t]+)*[Pp][Rr][Oo][Pp][Ee][Rr][Tt][Yy][ \\t]+(?:[Gg][Ee][Tt]|[Ll][Ee][Tt]|[Ss][Ee][Tt])[ \\t]+\\w|^[ \\t]*[Ii][Ff]\\b(?!.*\\b[Tt][Hh][Ee][Nn][ \\t]*(?:'|$).*\\S).*\\b[Tt][Hh][Ee][Nn][ \\t]*(?:'.*)?$|^[ \\t]*(?:[Ff][Oo][Rr]|[Dd][Oo]|[Ww][Hh][Ii][Ll][Ee]|[Ww][Ii][Tt][Hh])\\b|^[ \\t]*[Ss][Ee][Ll][Ee][Cc][Tt][ \\t]+[Cc][Aa][Ss][Ee]\\b|^[ \\t]*(?:[Tt][Yy][Pp][Ee]|[Ee][Nn][Uu][Mm])[ \\t]+\\w",
    "decreaseIndentPattern": "^[ \\t]*(?:[Ee][Nn][Dd][ \\t]+(?:[Ss][Uu][Bb]|[Ff][Uu][Nn][Cc][Tt][Ii][Oo][Nn]|[Pp][Rr][Oo][Pp][Ee][Rr][Tt][Yy]|[Ii][Ff]|[Ww][Ii][Tt][Hh]|[Ss][Ee][Ll][Ee][Cc][Tt]|[Tt][Yy][Pp][Ee]|[Ee][Nn][Uu][Mm])|[Nn][Ee][Xx][Tt]\\b|[Ll][Oo][Oo][Pp]\\b|[Ww][Ee][Nn][Dd]\\b|[Ee][Ll][Ss][Ee]\\b|[Ee][Ll][Ss][Ee][Ii][Ff]\\b|[Cc][Aa][Ss][Ee]\\b)"
  },
  "folding": {
    "markers": {
      "start": "(?i)^[ \\t]*((?:Public|Private|Friend|Global|Static)[ \\t]+)*(Sub|Function)[ \\t]+\\w|^[ \\t]*((?:Public|Private|Friend)[ \\t]+)*(Property)[ \\t]+(Get|Let|Set)[ \\t]+\\w|^[ \\t]*((?:Public|Private|Global)[ \\t]+)*(Type|Enum)[ \\t]+\\w",
      "end": "(?i)^[ \\t]*End[ \\t]+(Sub|Function|Property|Type|Enum)\\b"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^[ \t]*[Ii][Ff]\\b.*\\b[Tt][Hh][Ee][Nn][ \t]*(?:'.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*[Ee][Ll][Ss][Ee](?:[Ii][Ff]\\b.*\\b[Tt][Hh][Ee][Nn])?[ \t]*(?:'.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*[Cc][Aa][Ss][Ee]\\b.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*(?:[Ff][Oo][Rr]|[Dd][Oo]|[Ww][Hh][Ii][Ll][Ee]|[Ww][Ii][Tt][Hh])\\b.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*[Ss][Ee][Ll][Ee][Cc][Tt][ \t]+[Cc][Aa][Ss][Ee]\\b.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*(?:(?:[Pp][Uu][Bb][Ll][Ii][Cc]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Ff][Rr][Ii][Ee][Nn][Dd]|[Gg][Ll][Oo][Bb][Aa][Ll]|[Ss][Tt][Aa][Tt][Ii][Cc])[ \t]+)*(?:[Ss][Uu][Bb]|[Ff][Uu][Nn][Cc][Tt][Ii][Oo][Nn])[ \t]+\\w.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*(?:(?:[Pp][Uu][Bb][Ll][Ii][Cc]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Ff][Rr][Ii][Ee][Nn][Dd])[ \t]+)*[Pp][Rr][Oo][Pp][Ee][Rr][Tt][Yy][ \t]+(?:[Gg][Ee][Tt]|[Ll][Ee][Tt]|[Ss][Ee][Tt])[ \t]+\\w.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*(?:[Tt][Yy][Pp][Ee]|[Ee][Nn][Uu][Mm])[ \t]+\\w.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*#[ \t]*[Ii][Ff]\\b.*\\b[Tt][Hh][Ee][Nn][ \t]*(?:'.*)?$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^[ \t]*'''.*$",
      "action": { "indent": "none", "appendText": "''' " }
    },
    {
      "beforeText": "^[ \t]*'.*$",
      "action": { "indent": "none", "appendText": "' " }
    },
    {
      "beforeText": ".*[ \t]_$",
      "action": { "indent": "indent" }
    }
  ]
}
